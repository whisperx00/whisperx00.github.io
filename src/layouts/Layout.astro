---
import '../styles/global.css';

export interface Props {
  title: string;
  active: 'index' | 'writeups' | 'articles' | 'research' | 'tools' | 'skills' | 'about' | 'rss';
}
const { title, active } = Astro.props;

const nav = [
  { id: 'index',    href: '/',             label: 'index'    },
  { id: 'writeups',  href: '/writeups/',   label: 'writeups'  },
  { id: 'articles',  href: '/articles/',  label: 'articles'  },
  { id: 'research',  href: '/research/',  label: 'research'  },
  { id: 'tools',    href: '/tools/',       label: 'tools'    },
  { id: 'skills',   href: '/skills/',      label: 'skills'   },
  { id: 'about',    href: '/about/',       label: 'about'    },
  { id: 'rss',      href: '/rss/',         label: 'rss'      },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@500;600;700&display=swap" rel="stylesheet">
  <slot name="head" />
  <!-- Apply saved language before paint to avoid flash -->
  <script is:inline>
    (function(){
      var lang = localStorage.getItem('wx00-lang') || 'en';
      if (lang === 'pt') document.documentElement.lang = 'pt-BR';
    })();
  </script>
</head>
<body>

<nav class="topnav">
  <div class="nav-inner">
    <div class="brand"><span class="caret">&gt;</span> whisperx00@kali</div>
    <div class="nav-links">
      {nav.map(n => (
        <a href={n.href} class={active === n.id ? 'active' : ''}>
          <span class="slash">./</span><span class="label">{n.label}</span>
        </a>
      ))}
      <button class="lang-toggle" id="lang-toggle" aria-label="Switch language">
        <span class="lopt" data-lang="en">EN</span>
        <span class="lsep">|</span>
        <span class="lopt" data-lang="pt">PT</span>
      </button>
    </div>
  </div>
</nav>

<slot />

<slot name="statusbar" />

<footer>
  <div class="foot-inner">
    <div class="l">
      <span style="color:var(--sub);">whisperx00@kali</span>
      <span class="sep">|</span>
      <span>&copy; 2026</span>
      <span class="sep">|</span>
      <span data-lang="en">built in vim, served from a pi</span>
      <span data-lang="pt" hidden>feito no vim, servido num pi</span>
    </div>
    <div class="r">
      <a href="https://github.com/whisperx00" target="_blank" rel="noopener"><span class="slash">./</span>github</a>
      <a href="https://www.linkedin.com/in/manoel-albino-coelho-de-miranda-neto-6074b6237" target="_blank" rel="noopener"><span class="slash">./</span>linkedin</a>
      <a href="mailto:gm.manoel.albino@gmail.com"><span class="slash">./</span>mail</a>
    </div>
  </div>
</footer>

<script>
  const LANG_KEY = 'wx00-lang';

  function applyLang(lang: string, save: boolean) {
    document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
    document.querySelectorAll<HTMLElement>('[data-lang]').forEach(el => {
      const elLang = el.getAttribute('data-lang');
      if (elLang === lang) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
    document.querySelectorAll('.lopt').forEach(opt => {
      opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
    });
    if (save) localStorage.setItem(LANG_KEY, lang);
  }

  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const current = localStorage.getItem(LANG_KEY) || 'en';
    applyLang(current === 'en' ? 'pt' : 'en', true);
  });

  // Apply saved preference on every page load
  applyLang(localStorage.getItem(LANG_KEY) || 'en', false);
</script>

</body>
</html>
