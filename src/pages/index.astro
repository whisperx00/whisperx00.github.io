---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', p => !p.data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout title="whisperx00@kali — offsec notes" active="index">
  <main>
    <div class="cmd">
      <span class="u">whisperx00</span>@<span class="h">kali</span>:<span class="d">~</span>
      <span style="color:var(--text);">$ whoami --long</span>
    </div>

    <h1 class="title">offensive security researcher.</h1>
    <p class="lede">
      focus on <span class="hl">windows &amp; active directory</span>, web exploitation, and custom tooling.
      writeups from HTB labs, intern work at SiDi, and anything else worth documenting.
    </p>

    <div class="tags">
      <span class="tag" style="--col:var(--mauve);">active-directory</span>
      <span class="tag" style="--col:var(--blue);">windows</span>
      <span class="tag" style="--col:var(--peach);">web-exploitation</span>
      <span class="tag" style="--col:var(--green);">python</span>
      <span class="tag" style="--col:var(--teal);">typescript</span>
      <span class="tag" style="--col:var(--yellow);">oscp-in-progress</span>
    </div>

    <div class="section-head">
      <h2><span class="sym">▸</span>cat <span class="slash">/</span> <span style="color:var(--text);">whoami.txt</span></h2>
    </div>

    <section class="about">
      <div class="info">
        <div class="line"><span class="k">name</span><span class="v">Manoel Albino Coelho de Miranda <span class="dim">// whisperx00@kali</span></span></div>
        <div class="line"><span class="k">role</span><span class="v">offensive security researcher <span class="muted">— windows &amp; AD · web exploitation · custom tooling</span></span></div>
        <div class="line"><span class="k">experience</span><span class="v"><span class="muted">offensive security intern @ SiDi</span> <span class="dim">· samsung product assessments · AD exploitation · windows privesc · phishing simulation</span></span></div>
        <div class="line"><span class="k">location</span><span class="v">brazil <span class="dim">· open to remote and relocation</span></span></div>
        <div class="line"><span class="k">spoken</span><span class="v"><span class="muted">portuguese (native)</span> · <span class="muted">english (C1)</span> · <span class="muted">french (A2 · learning)</span></span></div>
        <div class="line"><span class="k">certs</span><span class="v">
          <span class="kbd training">OSCP · in progress</span>
          <span class="kbd planned">OSWP · planned</span>
          <span class="kbd planned">OSAI · planned</span>
        </span></div>
        <div class="line"><span class="k">skills</span><span class="v"><span class="muted">active directory · windows privesc · web exploitation · python · typescript / react</span></span></div>
        <div class="line"><span class="k">contact</span><span class="v">
          <a href="https://github.com/whisperx00" target="_blank" rel="noopener">github.com/whisperx00</a>
          <span class="sep">·</span>
          <a href="mailto:gm.manoel.albino@proton.me">gm.manoel.albino@proton.me</a>
          <span class="sep">·</span>
          <a href="https://www.linkedin.com/in/manoel-albino-coelho-de-miranda-neto-6074b6237" target="_blank" rel="noopener">linkedin</a>
          <span class="sep">·</span>
          <a href="/about/">full cv →</a>
        </span></div>
      </div>
    </section>

    <div class="section-head">
      <h2><span class="sym">▸</span>recent <span class="slash">/</span> <span style="color:var(--text);">posts</span></h2>
      <div class="meta"><span class="dot">●</span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</div>
    </div>

    <section class="posts">
      {posts.map(p => (
        <a href={`/posts/${p.id}/`} class="post" style={`--cat:var(--${p.data.accent});`}>
          <div class="meta">
            <span class="dt">{p.data.date}</span>
            <span>read {p.data.read}</span>
          </div>
          <div class="body">
            <div class="cat">{p.data.cat}</div>
            <h3>{p.data.title}</h3>
          </div>
          <div class="arrow">→</div>
        </a>
      ))}
    </section>

  </main>

  <div class="statusbar" slot="statusbar">
    <div class="statusbar-inner">
      <div class="left">
        <span><span class="dot"></span><span class="k">system:</span> <span class="v" style="color:var(--green);">operational</span></span>
        <span><span class="k">posts:</span> <span class="v">{posts.length}</span></span>
      </div>
      <div class="right">
        <span><span class="k">OSCP:</span> <span class="v" style="color:var(--yellow);">in progress</span></span>
      </div>
    </div>
  </div>
</Layout>

<style>
.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
.tag {
  font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: lowercase;
  padding: 3px 8px;
  border: 1px solid var(--col, var(--teal));
  color: var(--col, var(--teal));
  background: color-mix(in oklab, var(--col, var(--teal)) 10%, transparent);
}

.about { padding: 20px; background: var(--mantle); border: 1px solid var(--surface1); border-left: 2px solid var(--mauve); margin-bottom: 8px; }
.about .info { display: flex; flex-direction: column; gap: 14px; }
.about .line {
  display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: baseline;
  font-size: 12.5px; padding-bottom: 8px;
  border-bottom: 1px dashed color-mix(in oklab, var(--surface1) 60%, transparent);
}
.about .line:last-child { border-bottom: none; padding-bottom: 0; }
.about .line .k { color: var(--dim); }
.about .line .k::before { content: "$ "; color: var(--green); }
.about .line .v { color: var(--text); line-height: 1.6; }
.about .line .v .muted { color: var(--sub); }
.about .line .v .dim { color: var(--dim); }
.about .line .v a { color: var(--blue); border-bottom: 1px dotted var(--blue); }
.about .line .v a:hover { color: var(--mauve); border-color: var(--mauve); }
.about .line .v .sep { color: var(--surface1); margin: 0 6px; }
.kbd { display: inline-block; padding: 1px 6px; border: 1px solid var(--surface1); background: var(--base); color: var(--sub); font-size: 11px; margin-right: 5px; }
.kbd.training { color: var(--yellow); border-color: color-mix(in oklab, var(--yellow) 50%, var(--surface1)); }
.kbd.planned  { color: var(--dim); }

.posts { display: flex; flex-direction: column; gap: 10px; }
.post {
  display: grid; grid-template-columns: 140px 1fr auto; gap: 24px; align-items: flex-start;
  padding: 16px 20px 16px 16px; background: var(--mantle);
  border-left: 2px solid var(--cat, var(--mauve));
  transition: background .15s;
}
.post:hover { background: #1f1f2e; }
.post .meta { font-size: 11px; color: var(--dim); display: flex; flex-direction: column; gap: 3px; padding-top: 3px; }
.post .meta .dt { color: var(--sub); }
.post .body .cat {
  font-size: 10.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  color: var(--cat, var(--mauve)); margin-bottom: 6px; display: inline-flex; align-items: center; gap: 8px;
}
.post .body .cat::before { content: ""; display: inline-block; width: 6px; height: 6px; background: currentColor; }
.post .body h3 { font-family: var(--sans); font-weight: 600; font-size: 16px; color: var(--text); margin: 0; line-height: 1.35; }
.post .arrow { font-size: 18px; color: var(--dim); transition: color .15s, transform .15s; }
.post:hover .arrow { color: var(--cat, var(--mauve)); transform: translateX(3px); }

@media (max-width: 680px) {
  .post { grid-template-columns: 1fr; gap: 8px; }
  .about .line { grid-template-columns: 1fr; gap: 4px; }
}
</style>
