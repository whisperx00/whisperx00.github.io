---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="whisperx00@kali — skill tree" active="skills">
  <main class="skills-page">
    <div class="cmd">
      <span class="u">whisperx00</span>@<span class="h">kali</span>:<span class="d">~/skills</span>
      <span style="color:var(--text);">$ cat</span>
      <span class="arg">./tree.json</span>
      <span style="color:var(--text);">|</span>
      <span style="color:var(--text);">jq</span>
      <span class="flag">'.classes[]'</span>
    </div>

    <h1 class="title">skill tree <span class="slash">/</span> <span class="ext">v1.0</span></h1>
    <p class="lede">
      <span class="hl">A talent tree for offensive security.</span>
      branches diverge from each class's <code>origin</code> node.
      <span style="color:var(--mauve);">★ mastered</span>,
      <span style="color:var(--green);">● unlocked</span>,
      <span style="color:var(--yellow);">● training</span>,
      <span style="color:var(--dim);">○ locked</span>.
    </p>

    <section class="hud">
      <div class="cell" style="--col:var(--mauve);">
        <div class="k">profile · level</div>
        <div class="v">8 <span style="font-size:11px;color:var(--dim);font-weight:500;">/ 40</span></div>
        <div class="lvlbar"><span style="--p:20%;background:var(--mauve);"></span><span class="ticks"><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
        <div class="s">XP 3,200 · grinding OSCP</div>
      </div>
      <div class="cell" style="--col:var(--green);">
        <div class="k">talent points</div>
        <div class="v">10 / 22</div>
        <div class="s">spent across 4 classes</div>
      </div>
      <div class="cell" style="--col:var(--peach);">
        <div class="k">mastered</div>
        <div class="v">6</div>
        <div class="s">★ internalized + lab proof</div>
      </div>
      <div class="cell" style="--col:var(--yellow);">
        <div class="k">in training</div>
        <div class="v">4</div>
        <div class="s">currently grinding</div>
      </div>
    </section>

    <div class="legend">
      <div class="group">
        <span class="lab">states:</span>
        <span class="pip mastered">mastered</span>
        <span class="pip unlocked">unlocked</span>
        <span class="pip training">training</span>
        <span class="pip locked">locked</span>
      </div>
      <span class="sep">|</span>
      <div class="group">
        <span class="lab">controls:</span>
        <span>click a node for proof &amp; reqs</span>
        <span class="sep">·</span>
        <span>switch class with the tabs above the tree</span>
      </div>
    </div>

    <div class="classes" id="classTabs"></div>

    <div class="layout">
      <div class="canvas" id="canvas">
        <div class="grid-bg"></div>
        <svg class="links" id="links" preserveAspectRatio="none"></svg>
        <div class="nodes" id="nodes"></div>
      </div>
      <aside class="sidepanel idle" id="panel" data-state="">
        <div class="head"><div class="name">select a node</div></div>
        <div class="meta">click any hex on the tree to open its dossier — proofs, prereqs, time-on-task and notable artifacts.</div>
      </aside>
    </div>

    <section class="branchcards" id="branchcards"></section>
  </main>

  <div class="statusbar" slot="statusbar">
    <div class="statusbar-inner">
      <div class="left">
        <span><span class="dot"></span><span class="k">tree:</span> <span class="v" style="color:var(--green);">in progress · v1</span></span>
        <span><span class="k">classes:</span> <span class="v">4</span></span>
        <span><span class="k">nodes:</span> <span class="v">22</span></span>
      </div>
      <div class="right">
        <span><span class="k">tooltip:</span> <span class="v">click hex → side panel</span></span>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .skills-page main { max-width: 1200px; }
  .hud { display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr;gap:10px;margin:0 0 22px; }
  .hud .cell { background:var(--mantle);border:1px solid var(--surface1);border-left:2px solid var(--col,var(--mauve));padding:11px 14px; }
  .hud .cell .k { font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim); }
  .hud .cell .v { font-weight:700;font-size:18px;color:var(--col,var(--text));margin-top:4px; }
  .hud .cell .s { font-size:10.5px;color:var(--sub);margin-top:2px; }
  .hud .lvlbar { margin-top:6px;height:5px;background:var(--surface0);position:relative;overflow:hidden; }
  .hud .lvlbar > span { display:block;height:100%;width:var(--p,20%); }
  .hud .lvlbar .ticks { position:absolute;inset:0;display:flex; }
  .hud .lvlbar .ticks i { flex:1;border-right:1px solid var(--mantle); }

  .legend { display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px;background:var(--mantle);border:1px solid var(--surface1);padding:10px 14px;align-items:center;font-size:11px;color:var(--sub); }
  .legend .group { display:flex;gap:14px;align-items:center;flex-wrap:wrap; }
  .legend .lab { color:var(--dim);letter-spacing:.06em;text-transform:uppercase;font-size:10px; }
  .legend .pip { display:inline-flex;align-items:center;gap:6px; }
  .legend .pip::before { content:"";width:9px;height:9px;display:inline-block; }
  .legend .pip.unlocked::before { background:var(--green);box-shadow:0 0 6px var(--green); }
  .legend .pip.mastered::before { background:var(--mauve);box-shadow:0 0 6px var(--mauve); }
  .legend .pip.training::before { background:var(--yellow); }
  .legend .pip.locked::before { background:var(--dim);opacity:.5; }
  .legend .sep { color:var(--surface1); }

  .classes { display:flex;gap:0;background:var(--mantle);border:1px solid var(--surface1);margin-bottom:14px;overflow-x:auto; }
  .classes button { background:transparent;border:0;border-right:1px solid var(--surface1);color:var(--dim);font-family:var(--mono);font-size:12px;padding:11px 16px;cursor:pointer;white-space:nowrap;letter-spacing:.04em;transition:color .15s,background .15s;display:flex;align-items:center;gap:8px; }
  .classes button:last-child { border-right:0; }
  .classes button:hover { color:var(--text); }
  .classes button.on { color:var(--text);background:var(--surface0); }
  .classes button .glyph { width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:var(--col,var(--mauve));font-size:13px; }
  .classes button.on .glyph { filter:drop-shadow(0 0 4px var(--col,var(--mauve))); }
  .classes button .pts { margin-left:6px;font-size:10px;color:var(--dim); }
  .classes button.on .pts { color:var(--col,var(--mauve)); }

  .canvas { position:relative;background:radial-gradient(ellipse at 50% 0%, color-mix(in oklab, var(--col,var(--mauve)) 16%, transparent) 0%, transparent 60%),var(--mantle);border:1px solid var(--surface1);border-top:2px solid var(--col,var(--mauve));overflow:hidden;min-height:780px; }
  .canvas .grid-bg { position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(to right, color-mix(in oklab, var(--surface1) 50%, transparent) 1px, transparent 1px),linear-gradient(to bottom, color-mix(in oklab, var(--surface1) 50%, transparent) 1px, transparent 1px);background-size:32px 32px;mask-image:radial-gradient(ellipse at 50% 30%, #000 0%, #000 60%, transparent 100%);opacity:.4; }
  .canvas svg.links { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
  .canvas svg.links path { fill:none;stroke-width:2;stroke-linecap:round; }
  .canvas svg.links path.unlocked { stroke:color-mix(in oklab,var(--green) 70%, transparent); }
  .canvas svg.links path.mastered { stroke:color-mix(in oklab,var(--mauve) 80%, transparent);filter:drop-shadow(0 0 5px color-mix(in oklab,var(--mauve) 60%, transparent)); }
  .canvas svg.links path.training { stroke:color-mix(in oklab,var(--yellow) 70%, transparent);stroke-dasharray:5 4;animation:dash 22s linear infinite; }
  .canvas svg.links path.locked { stroke:var(--surface1);stroke-dasharray:3 5; }
  @keyframes dash { to { stroke-dashoffset:-200; } }

  .nodes { position:absolute;inset:0; }
  .node { position:absolute;transform:translate(-50%,-50%);width:120px;display:flex;flex-direction:column;align-items:center;text-align:center;cursor:pointer;transition:transform .15s; }
  .node:hover { transform:translate(-50%,-50%) scale(1.04); }
  .node.selected { transform:translate(-50%,-50%) scale(1.08); }
  .node .badge { width:54px;height:54px;background:var(--mantle);display:flex;align-items:center;justify-content:center;color:var(--state,var(--dim));font-weight:700;font-size:18px;position:relative;transition:box-shadow .2s,background .15s;clip-path:polygon(50% 0%,93% 25%,93% 75%,50% 100%,7% 75%,7% 25%);box-shadow:inset 0 0 0 2px var(--state,var(--dim)),0 0 0 4px var(--mantle),inset 0 0 0 6px color-mix(in oklab,var(--state,var(--dim)) 35%, var(--mantle)); }
  .node:hover .badge { box-shadow:inset 0 0 0 2px var(--state,var(--dim)),0 0 0 4px var(--mantle),inset 0 0 0 6px color-mix(in oklab,var(--state,var(--dim)) 35%, var(--mantle)),0 0 16px color-mix(in oklab,var(--state,var(--dim)) 70%, transparent); }
  .node.selected .badge { box-shadow:inset 0 0 0 2px var(--state,var(--dim)),0 0 0 4px var(--mantle),inset 0 0 0 6px color-mix(in oklab,var(--state,var(--dim)) 50%, var(--mantle)),0 0 22px color-mix(in oklab,var(--state,var(--dim)) 90%, transparent); }
  .node[data-state="locked"] { opacity:.55; }
  .node[data-state="locked"] .badge { filter:saturate(.3); }
  .node[data-state="mastered"] .badge { background:color-mix(in oklab,var(--mauve) 18%, var(--mantle)); }
  .node[data-state="mastered"] .badge::after { content:"★";position:absolute;top:-9px;right:-9px;font-size:11px;color:var(--mauve);background:var(--crust);width:18px;height:18px;display:flex;align-items:center;justify-content:center;border:1px solid var(--mauve);box-shadow:0 0 8px color-mix(in oklab,var(--mauve) 60%, transparent); }
  .node[data-state="training"] .badge::after { content:"";position:absolute;top:-7px;right:-7px;width:12px;height:12px;border-radius:50%;background:var(--yellow);border:2px solid var(--crust);animation:pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.25);opacity:.6;} }
  .node .badge .ico { font-size:20px;line-height:1;color:inherit;font-weight:700; }
  .node .label { margin-top:8px;font-size:11px;color:var(--text);font-weight:600;line-height:1.25;text-shadow:0 1px 2px var(--crust),0 0 6px var(--crust); }
  .node[data-state="locked"] .label { color:var(--dim); }
  .node .lvl { margin-top:3px;font-size:10px;color:var(--state,var(--dim));letter-spacing:.06em;background:var(--crust);padding:1px 6px;border:1px solid var(--surface1); }
  .node[data-state="mastered"] { --state:var(--mauve); }
  .node[data-state="unlocked"] { --state:var(--green); }
  .node[data-state="training"] { --state:var(--yellow); }
  .node[data-state="locked"]   { --state:var(--dim); }

  .node.origin .badge { width:72px;height:72px;box-shadow:inset 0 0 0 2px var(--col,var(--mauve)),0 0 0 5px var(--mantle),inset 0 0 0 8px color-mix(in oklab,var(--col,var(--mauve)) 50%, var(--mantle)),0 0 26px color-mix(in oklab,var(--col,var(--mauve)) 60%, transparent);color:var(--col,var(--mauve)); }
  .node.origin .badge .ico { font-size:24px; }
  .node.origin .label { font-size:13px;color:var(--col,var(--mauve)); }
  .node.origin .lvl { color:var(--col,var(--mauve));border-color:color-mix(in oklab,var(--col,var(--mauve)) 50%, var(--surface1)); }
  .node.origin { width:140px; }

  .branch-label { position:absolute;bottom:14px;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);padding:5px 12px;background:var(--crust);border:1px solid var(--surface1);transform:translateX(-50%); }
  .branch-label .accent { color:var(--c,var(--mauve));margin-right:6px; }

  .layout { display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start; }
  @media (max-width:1024px) { .layout { grid-template-columns:1fr; } }

  .sidepanel { background:var(--mantle);border:1px solid var(--surface1);border-left:2px solid var(--col,var(--mauve));padding:18px 20px;font-size:12px;position:sticky;top:80px; }
  .sidepanel .head { display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:10px; }
  .sidepanel .name { font-weight:700;font-size:16px;color:var(--text); }
  .sidepanel .lvl-pill { font-size:10px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:2px 7px;border:1px solid currentColor;color:var(--state,var(--mauve));white-space:nowrap; }
  .sidepanel[data-state="mastered"] .lvl-pill { --state:var(--mauve); }
  .sidepanel[data-state="unlocked"] .lvl-pill { --state:var(--green); }
  .sidepanel[data-state="training"] .lvl-pill { --state:var(--yellow); }
  .sidepanel[data-state="locked"]   .lvl-pill { --state:var(--dim); }
  .sidepanel .meta { font-size:10.5px;color:var(--dim);margin-bottom:14px; }
  .sidepanel .meta .b { color:var(--col,var(--mauve)); }
  .sidepanel .desc { color:var(--sub);font-size:12px;line-height:1.7;margin-bottom:14px; }
  .sidepanel .desc :global(.hl) { color:var(--text); }
  .sidepanel .stats { display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin-bottom:14px; }
  .sidepanel .stats .r { display:flex;justify-content:space-between;font-size:11px;border-bottom:1px dashed color-mix(in oklab,var(--surface1) 50%,transparent);padding-bottom:4px; }
  .sidepanel .stats .r .k { color:var(--dim); }
  .sidepanel .stats .r .v { color:var(--text); }
  .sidepanel h4 { margin:14px 0 6px;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--col,var(--mauve)); }
  .sidepanel ul.tags { list-style:none;margin:0 0 4px;padding:0;display:flex;flex-wrap:wrap;gap:5px; }
  .sidepanel ul.tags li { font-size:10.5px;color:var(--sub);background:var(--base);border:1px solid var(--surface1);padding:1px 7px; }
  .sidepanel .proofs { margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px; }
  .sidepanel .proofs li { font-size:11px;color:var(--sub);display:flex;gap:8px;align-items:flex-start; }
  .sidepanel .proofs li::before { content:"▸";color:var(--col,var(--mauve));margin-top:1px; }
  .sidepanel .reqs { font-size:11px;color:var(--dim);margin-bottom:6px; }
  .sidepanel .reqs .satisfied { color:var(--green); }
  .sidepanel .reqs .missing { color:var(--red); }
  .sidepanel.idle { border-left-color:var(--surface1); }
  .sidepanel.idle .name { color:var(--dim); }

  .branchcards { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px; }
  @media (max-width:820px) { .branchcards { grid-template-columns:1fr; } }
  .bc { background:var(--mantle);border:1px solid var(--surface1);border-top:2px solid var(--c,var(--green));padding:14px 16px;font-size:11.5px; }
  .bc h4 { margin:0 0 5px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--c,var(--green)); }
  .bc p { margin:0 0 6px;color:var(--sub);line-height:1.55;font-size:11px; }
  .bc .key { font-size:10px;color:var(--dim);letter-spacing:.06em;text-transform:uppercase; }
  .bc .key b { color:var(--text);font-weight:600; }
  @media (max-width:680px) { .hud { grid-template-columns:1fr 1fr; } .canvas { min-height:1100px; } }
</style>

<script>
const CLASSES = [
  {
    id:"winAD", name:"Windows & AD", glyph:"⎘", color:"mauve", points:"4/8",
    origin:{ id:"wa-root", label:"AD Enumeration", lvl:"core", state:"mastered",
