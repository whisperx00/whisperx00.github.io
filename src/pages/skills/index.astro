  {
    id:"engineering", name:"Engineering", glyph:"◈", color:"teal", points:"2/5",
    origin:{ id:"en-root", label:"Programming", lvl:"core", state:"mastered",
      desc:"the tooling that makes the offensive work faster. python for scripting, typescript for frontends.",
      tags:["python","typescript","react"], proofs:["shipped tools: burp-intruder-cli, ldap-parse"],
      stat:{xp:"800",time:"ongoing"} },
    branches:[
      { name:"Languages", color:"teal", labelX:25,
        nodes:[
          { id:"en-py", label:"Python", lvl:"C1", state:"mastered", parent:"en-root",
            desc:"primary scripting language for exploit automation, parsing tools, and quick PoCs. ldap_parse.py shipped as a tool.",
            tags:["python","scripting","automation"], proofs:["ldap-parse.py","SiDi tooling"],
