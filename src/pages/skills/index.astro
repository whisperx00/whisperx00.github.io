const W=1000,H=780;
function layout(klass){
  const pos={};
  pos[klass.origin.id]={x:50,y:12,node:klass.origin,branchColor:klass.color,isOrigin:true};
  klass.branches.forEach(br=>{
    const cx=br.labelX,n=br.nodes.length,yStart=28,yEnd=84;
    br.nodes.forEach((nd,i)=>{
      const t=n===1?0:i/(n-1);
      const offset=(i%2===0?-7:7)*(i>0?1:0);
      const x=i===0?lerp(cx,50,0.18):cx+offset;
      const y=yStart+t*(yEnd-yStart);
      pos[nd.id]={x,y,node:nd,branchColor:br.color};
    });
  });
  return pos;
}
function lerp(a,b,t){return a+(b-a)*t;}

const tabsHost=document.getElementById('classTabs');
const canvas=document.getElementById('canvas');
const linksSvg=document.getElementById('links');
const nodesEl=document.getElementById('nodes');
const panel=document.getElementById('panel');
const branchHost=document.getElementById('branchcards');

let active=CLASSES[0].id,selected=null;

tabsHost.innerHTML=CLASSES.map(c=>`<button data-id="${c.id}" class="${c.id===active?'on':''}" style="--col:var(--${c.color});"><span class="glyph">${c.glyph}</span><span>${c.name}</span><span class="pts">${c.points}</span></button>`).join('');
tabsHost.addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  active=b.dataset.id;
  document.querySelectorAll('#classTabs button').forEach(x=>x.classList.toggle('on',x.dataset.id===active));
  selected=null;render();
});

function lookupNode(klass,id){
  if(klass.origin.id===id)return klass.origin;
  for(const br of klass.branches)for(const n of br.nodes)if(n.id===id)return n;
  return null;
}

function render(){
  const klass=CLASSES.find(c=>c.id===active);
  const pos=layout(klass);
  canvas.style.setProperty('--col',`var(--${klass.color})`);
  const links=[];
  klass.branches.forEach(br=>{br.nodes.forEach(nd=>{const a=pos[nd.parent],b=pos[nd.id];if(!a||!b)return;links.push({a,b,state:nd.state});});});
  linksSvg.setAttribute('viewBox',`0 0 ${W} ${H}`);
  linksSvg.innerHTML=links.map(L=>{
    const x1=L.a.x*W/100,y1=L.a.y*H/100,x2=L.b.x*W/100,y2=L.b.y*H/100,my=(y1+y2)/2;
    return `<path class="${L.state}" d="M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}" />`;
  }).join('');
  const branchLabels=klass.branches.map(br=>`<div class="branch-label" style="left:${br.labelX}%;--c:var(--${br.color});"><span class="accent">▸</span>${br.name}</div>`).join('');
  const nodesHTML=Object.values(pos).map(p=>{
    const isOrigin=p.isOrigin,ico=isOrigin?klass.glyph:(p.node.label[0]||'?'),isSel=selected===p.node.id;
    return `<div class="node ${isOrigin?'origin':''} ${isSel?'selected':''}" data-state="${p.node.state}" data-id="${p.node.id}" style="left:${p.x}%;top:${p.y}%;--col:var(--${isOrigin?klass.color:p.branchColor});"><div class="badge"><span class="ico">${ico}</span></div><div class="label">${p.node.label}</div><div class="lvl">${p.node.lvl}</div></div>`;
  }).join('');
  nodesEl.innerHTML=nodesHTML+branchLabels;
  nodesEl.querySelectorAll('.node').forEach(el=>{
    el.addEventListener('click',()=>{selected=el.dataset.id;nodesEl.querySelectorAll('.node').forEach(x=>x.classList.toggle('selected',x.dataset.id===selected));renderPanel();});
  });
  branchHost.innerHTML=klass.branches.map(br=>{
    const m=br.nodes.filter(n=>n.state==='mastered').length,t=br.nodes.length;
    return `<article class="bc" style="--c:var(--${br.color});"><h4>▸ ${br.name}</h4><p>${m} of ${t} nodes mastered · path entry from <b style="color:var(--${br.color});">${klass.origin.label}</b>.</p><div class="key"><b>${br.nodes[0]?.label||''}</b> → ${br.nodes.slice(1).map(n=>n.label).join(' → ')||'—'}</div></article>`;
  }).join('');
  renderPanel();
}

function renderPanel(){
  if(!selected){
    panel.classList.add('idle');panel.dataset.state='';
    panel.innerHTML='<div class="head"><div class="name">select a node</div></div><div class="meta">click any hex on the tree to open its dossier — proofs, prereqs, time-on-task and notable artifacts.</div>';
    return;
  }
  const klass=CLASSES.find(c=>c.id===active);
  const n=lookupNode(klass,selected);
  if(!n){selected=null;renderPanel();return;}
  const branchOf=klass.origin.id===n.id?null:klass.branches.find(br=>br.nodes.some(x=>x.id===n.id));
  const col=branchOf?branchOf.color:klass.color;
  let reqs='';
  if(n.parent){const parent=lookupNode(klass,n.parent);const ok=parent&&(parent.state==='mastered'||parent.state==='unlocked');reqs=`<div class="reqs">requires <b style="color:var(--text);">${parent?.label||'—'}</b> · <span class="${ok?'satisfied':'missing'}">${ok?'✓ satisfied':'✗ missing'}</span></div>`;}
  else{reqs='<div class="reqs">root node · <span class="satisfied">no prerequisites</span></div>';}
  panel.classList.remove('idle');panel.style.setProperty('--col',`var(--${col})`);panel.dataset.state=n.state;
  panel.innerHTML=`<div class="head"><div class="name">${n.label}</div><div class="lvl-pill">${n.lvl} · ${n.state}</div></div><div class="meta"><span class="b">${branchOf?branchOf.name:'origin'}</span> · class: ${klass.name}</div><div class="desc">${n.desc}</div>${reqs}<div class="stats">${Object.entries(n.stat).map(([k,v])=>`<div class="r"><span class="k">${k}</span><span class="v">${v}</span></div>`).join('')}</div><h4>tags</h4><ul class="tags">${(n.tags||[]).map(t=>`<li>#${t}</li>`).join('')}</ul><h4>proof / artifacts</h4><ul class="proofs">${(n.proofs||[]).map(p=>`<li>${p}</li>`).join('')||'<li>no public artifacts</li>'}</ul>`;
}
render();
</script>
