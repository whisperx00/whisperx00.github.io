      </div>
    </section>

    <!-- quick stats -->
    <section class="stripe">
      <div class="qs" style="--col:var(--yellow);"><div class="k"><span data-lang="en">current focus</span><span data-lang="pt" hidden>foco atual</span></div><div class="v">OSCP</div><div class="s"><span data-lang="en">studying full-time</span><span data-lang="pt" hidden>tempo integral</span></div></div>
      <div class="qs" style="--col:var(--teal);"><div class="k"><span data-lang="en">tools built</span><span data-lang="pt" hidden>ferramentas</span></div><div class="v">2</div><div class="s"><span data-lang="en">published · in use</span><span data-lang="pt" hidden>publicadas · em uso</span></div></div>
      <div class="qs" style="--col:var(--blue);"><div class="k"><span data-lang="en">primary focus</span><span data-lang="pt" hidden>área principal</span></div><div class="v">AD / web</div><div class="s"><span data-lang="en">windows · exploitation</span><span data-lang="pt" hidden>windows · exploração</span></div></div>
