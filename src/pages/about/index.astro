      <span style="color:var(--text);">$ cat</span>
      <span class="arg">cv.md</span>
      <span class="flag">|</span>
      <span style="color:var(--text);">less</span>
    </div>

    <!-- recruiter hero -->
    <section class="hero">
      <div class="photo">
        <img src="/pfp.jpg" alt="whisperx00" />
      </div>
      <div>
        <h1>Manoel Albino Coelho de Miranda Neto</h1>
        <div class="role">
          <span data-lang="en">Offensive Security Researcher · <span class="hl">windows &amp; AD · web exploitation · custom tooling</span></span>
          <span data-lang="pt" hidden>Pesquisador de Segurança Ofensiva · <span class="hl">windows &amp; AD · exploração web · ferramentas</span></span>
        </div>
        <div class="meta">
          <span><span class="k">📍</span><span class="v">brazil</span></span>
          <span><span class="k">●</span><span class="v"><span data-lang="en">open to remote &amp; relocation</span><span data-lang="pt" hidden>aberto a remoto e realocação</span></span></span>
